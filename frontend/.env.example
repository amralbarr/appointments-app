# copy to .env.local, fill in real values for your environment.

# server-side only — the BFF route handlers' own fetch target. never sent
# to the browser.
BACKEND_INTERNAL_URL=http://localhost:6410/api/v1

# browser-visible (NEXT_PUBLIC_ prefix) — the Socket.IO client connects
# directly from the browser (see src/lib/socket.ts), so this must be a
# real address a VISITOR's browser can reach - never localhost in
# production, even though the backend itself runs on this same host.
# Locally that's http://localhost:6410 (no nginx in front yet); in
# production it's the real public domain
# (ngnix/appointments.buildron.net's own /socket.io/ location proxies it
# through to the backend from there).
NEXT_PUBLIC_BACKEND_SOCKET_URL=http://localhost:6410
