# copy to .env, fill in real values. never commit .env itself.

# only read by docker-compose.yml, to set the dev/prod postgres
# container's own credentials - defaults to slotbook/slotbook (matching
# DATABASE_URL below) if left unset. setup.sh generates a real random
# password for these on a fresh server; local dev can leave them unset.
POSTGRES_USER=slotbook
POSTGRES_PASSWORD=slotbook
POSTGRES_DB=slotbook

DATABASE_URL="postgresql://slotbook:slotbook@localhost:6412/slotbook"
DATABASE_URL_TEST="postgresql://slotbook:slotbook@localhost:5433/slotbook_test"

PORT=6410

# any long random string, rotate if it ever leaks
JWT_ACCESS_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# shared secret between this backend and the mcp gateway process,
# see docs/MCP-INTEGRATION.md — not a per-user credential
MCP_INTERNAL_SECRET=dev-only-change-me-again

# the in-house ai booking assistant's own credential (ChatModule) — a
# company-internal AI gateway (ai.qtech.sa), never a direct paid model
# provider. a real token, never invented/committed.
AI_GATEWAY_API_KEY=
# defaults baked into chat.service.ts if left unset - only override if
# this app needs to point at a different gateway/provider/model.
AI_GATEWAY_URL=https://ai.qtech.sa/media/api/v1/text/generate
AI_GATEWAY_PROVIDER=agentox
AI_CHAT_MODEL=company-coder
