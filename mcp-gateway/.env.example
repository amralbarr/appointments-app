# copy to .env (gitignored). same shape as the gateway's other platforms -
# see README.md for what each of these is actually for.

GATEWAY_URL=http://localhost:3100
# GATEWAY_URL=https://mcp.buildron.net

# scoped to the "appointments" platform id - mint from
# /admin/platforms/appointments/edit once the platform is registered.
APPOINTMENTS_EDIT_KEY=

# only needed once, to register the platform the first time
ACCOUNT_API_KEY=
APPOINTMENTS_AUTH_JSON='{"strategy":"apiKeyVerify","keyPrefix":"sk_live_","verifyUrl":"https://api.slotbook.example.com/api/v1/auth/mcp/verify","verifyHeaderName":"x-internal-secret","verifySecretEnv":"APPOINTMENTS_MCP_INTERNAL_SECRET","forwardTokenField":"accessToken","scopesField":"scopes"}'

# must match this backend's own MCP_INTERNAL_SECRET env var exactly - see
# the main .env.example and docs/MCP-INTEGRATION.md
APPOINTMENTS_MCP_INTERNAL_SECRET=
