# One centralized place to fill in every real secret this app needs in
# production - copy to .env.production at the repo root, fill in real
# values, then run ./setup.sh (reads this file if present and distributes
# each value into the specific service's own .env/.env.local that its
# actual code reads - backend/frontend/mcp-gateway each still load their
# config from their own directory; this file is just the one place a
# human edits instead of hunting across three separate .env.example
# files). Never commit .env.production itself - same as every other real
# .env in this repo.
#
# Safe to re-run ./setup.sh after editing this file - it only ever
# overwrites a service's .env with what's in here, never invents a value
# on top of what you've set, and still auto-generates anything you leave
# blank below (JWT/MCP secrets, the db password) the same way it always
# has if this file doesn't exist at all.

# ── Postgres (backend/docker-compose.yml) ──────────────────────────────────
# leave blank to have setup.sh generate a real random password
POSTGRES_PASSWORD=

# ── backend/.env ────────────────────────────────────────────────────────────
# leave the three secrets below blank to have setup.sh generate real
# random values (JWT_ACCESS_SECRET/JWT_REFRESH_SECRET independently,
# MCP_INTERNAL_SECRET shared verbatim with mcp-gateway's
# APPOINTMENTS_MCP_INTERNAL_SECRET below - never set one without the
# other, they must be identical)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
MCP_INTERNAL_SECRET=

# the in-house ai booking assistant's own credential - a company-internal
# AI gateway (ai.qtech.sa), never a direct paid model provider. required,
# can't be generated.
AI_GATEWAY_API_KEY=
# only override if this app needs a different gateway/provider/model than
# the defaults already baked into chat.service.ts
AI_GATEWAY_URL=
AI_GATEWAY_PROVIDER=
AI_CHAT_MODEL=

# ── mcp-gateway/.env ─────────────────────────────────────────────────────────
# the real shared production gateway - not this machine's local dev instance.
GATEWAY_URL=https://mcp.buildron.net
# only needed once, to register this platform the first time
# (mcp-gateway/register.sh) - a personal, account-level key from the
# gateway's own /admin/account page. not auto-generated.
ACCOUNT_API_KEY=
# minted from the gateway's /admin/platforms/appointments/edit page after
# registration - push.sh/pull.sh's own credential, not auto-generated.
APPOINTMENTS_EDIT_KEY=
